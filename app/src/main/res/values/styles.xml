<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Teks -->
    <style name="Kopi.Title" parent="">
        <item name="android:textColor">@color/primary_900</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="Kopi.Subtitle" parent="">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <style name="Kopi.SectionTitle" parent="">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <!-- Tombol utama -->
    <style name="Kopi.Button.Primary" parent="">
        <item name="android:background">@drawable/bg_primary_button</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">58dp</item>
        <item name="android:paddingHorizontal">24dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Tombol outline -->
    <style name="Kopi.Button.Secondary" parent="">
        <item name="android:background">@drawable/bg_secondary_button</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">58dp</item>
        <item name="android:paddingHorizontal">24dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/primary_900</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Menu navigasi bawah -->
    <style name="Kopi.Button.Nav" parent="">
        <item name="android:background">@drawable/bg_nav_item</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:drawableTint">@color/hint</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/hint</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Kopi.Button.Nav.Active" parent="Kopi.Button.Nav">
        <item name="android:drawableTint">@color/primary_900</item>
        <item name="android:textColor">@color/primary_900</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Input -->
    <style name="Kopi.Field" parent="">
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:drawableTint">@color/primary_500</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/hint</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Foto produk / gambar -->
    <style name="Kopi.Image" parent="">
        <item name="android:background">@drawable/bg_image</item>
        <item name="android:clipToOutline">true</item>
        <item name="android:scaleType">centerCrop</item>
    </style>
</resources>

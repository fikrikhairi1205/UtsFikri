<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:contentDescription="Logo"
            android:scaleType="centerInside"
            android:src="@drawable/logo2f" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Selamat datang di"
            android:textColor="@color/muted"
            android:textSize="15sp" />

        <TextView
            style="@style/Kopi.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Kopi dan Nyemil"
            android:textSize="34sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Get a taste of your wish"
            android:textColor="@color/primary_500"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            style="@style/Kopi.Subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:text="Rasa hangat, cerita yang dekat, dan camilan yang selalu pas untuk menemani harimu." />
    </LinearLayout>

    <Button
        android:id="@+id/btnStart"
        style="@style/Kopi.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Mulai sekarang" />
</LinearLayout>
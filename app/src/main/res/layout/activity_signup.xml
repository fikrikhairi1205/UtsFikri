<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:contentDescription="Logo"
            android:scaleType="centerInside"
            android:src="@drawable/logo2f" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Kopi dan Nyemil"
            android:textColor="@color/primary_700"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imgSignup1"
            style="@style/Kopi.Image"
            android:layout_width="0dp"
            android:layout_height="210dp"
            android:layout_marginEnd="7dp"
            android:layout_marginBottom="36dp"
            android:layout_weight="1"
            android:contentDescription="Foto menu 1"
            android:scaleType="centerCrop"
            android:src="@drawable/americano" />

        <ImageView
            android:id="@+id/imgSignup2"
            style="@style/Kopi.Image"
            android:layout_width="0dp"
            android:layout_height="210dp"
            android:layout_marginStart="7dp"
            android:layout_marginTop="36dp"
            android:layout_weight="1"
            android:contentDescription="Foto menu 2"
            android:scaleType="centerCrop"
            android:src="@drawable/croissant" />
    </LinearLayout>

    <TextView
        style="@style/Kopi.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Mulai perjalanan rasa" />

    <TextView
        style="@style/Kopi.Subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Buat akun dan nikmati berbagai menu favorit di tempat kami." />

    <Button
        android:id="@+id/btnRegister"
        style="@style/Kopi.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Daftar akun" />

    <Button
        android:id="@+id/btnLogin"
        style="@style/Kopi.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Saya sudah punya akun" />
</LinearLayout>
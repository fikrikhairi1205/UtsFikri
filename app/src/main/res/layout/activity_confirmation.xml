<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:fitsSystemWindows="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <FrameLayout
        android:layout_width="156dp"
        android:layout_height="156dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_success_soft" />

        <FrameLayout
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_success">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:contentDescription="Berhasil"
                android:src="@drawable/ic_check"
                android:tint="@color/white" />
        </FrameLayout>
    </FrameLayout>

    <TextView
        style="@style/Kopi.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Pesanan berhasil!"
        android:textSize="28sp" />

    <TextView
        style="@style/Kopi.Subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="Terima kasih sudah memesan. Tunggu ya, sebentar lagi kami mengantarkan pesananmu." />

    <Button
        android:id="@+id/btnDone"
        style="@style/Kopi.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:text="Kembali ke beranda" />
</LinearLayout>
